{
  "name": "ThemeFile",
  "type": "object",
  "properties": {
    "path": {
      "type": "string",
      "description": "Theme asset path as Shopify expects it, e.g. 'assets/theme.css', 'sections/header.liquid'"
    },
    "file_uri": {
      "type": "string",
      "description": "Private storage URI of the file's contents"
    },
    "deleted": {
      "type": "boolean",
      "default": false,
      "description": "When true, the sync removes this asset from the Shopify theme"
    }
  },
  "required": [
    "path",
    "file_uri"
  ]
}