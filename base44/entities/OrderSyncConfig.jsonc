{
  "name": "OrderSyncConfig",
  "type": "object",
  "properties": {
    "spreadsheet_id": {
      "type": "string",
      "description": "Google Sheets ID of the sales tracking spreadsheet"
    },
    "spreadsheet_url": {
      "type": "string",
      "description": "Link to the sales tracking spreadsheet"
    }
  },
  "required": [
    "spreadsheet_id"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}