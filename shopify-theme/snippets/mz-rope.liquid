{%- comment -%}
  mz-rope — sailor-yellow rope band with products hanging on clothespins.
  Mirrors the app's RopeLine design: one sagging rope curve, items pinned
  below it. Positions are precomputed from the same bezier curve.
{%- endcomment -%}
<style>
.mz-rope{padding:56px 0 40px;text-align:center;background:#0a0a0d}
.mz-rope-eye{font-family:'Space Grotesk',sans-serif;font-size:10px;font-weight:500;letter-spacing:.4em;text-transform:uppercase;color:rgba(246,241,230,.55);margin:0 0 48px}
.mz-rope-stage{position:relative;height:300px}
@media(min-width:641px){.mz-rope-stage{height:400px}}
.mz-rope-svg{position:absolute;top:0;left:0;width:100%;height:132px}
.mz-rope-item{position:absolute;top:0;bottom:0;width:0}
.mz-rope-line{position:absolute;left:0;width:2px;transform:translateX(-50%);background:#D9A83C}
.mz-rope-pin{position:absolute;left:0;width:10px;height:16px;transform:translateX(-50%);border-radius:2px;border:1px solid #8A641B;background:#B08748}
.mz-rope-card{position:absolute;left:0;transform:translateX(-50%);display:block;width:24vw;max-width:200px}
.mz-rope-card div{aspect-ratio:1/1;overflow:hidden;border-radius:2px;border:1px solid rgba(255,255,255,.08);background:#131317}
.mz-rope-card img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .5s ease}
.mz-rope-card:hover img{transform:scale(1.05) rotate(1.5deg)}
.mz-rope-cap{margin:8px 0 0;font-family:'Inter',sans-serif;font-size:11px;font-weight:500;color:#f6f1e6;text-decoration:none}
</style>

<section class="mz-rope" aria-label="Mazrood products hung on the studio line">
  <p class="mz-rope-eye">02 — Fresh off the line</p>

  <div class="mz-rope-stage">
    <svg class="mz-rope-svg" aria-hidden="true" viewBox="0 0 100 100" preserveAspectRatio="none">
      <path d="M 0 18 C 25 62 75 62 100 18" fill="none" stroke="#D9A83C" stroke-width="3" stroke-linecap="round" vector-effect="non-scaling-stroke"></path>
      <path d="M 0 18 C 25 62 75 62 100 18" fill="none" stroke="#8A641B" stroke-width="3" stroke-linecap="round" stroke-dasharray="6 9" opacity="0.5" vector-effect="non-scaling-stroke"></path>
    </svg>

    {%- assign rope_items = "mzrd Bubble Cap|https://mazrood.com/cdn/shop/files/DSC06373Large_700x.jpg?v=1787983760|https://mazrood.com/products/mzrd-bubble-cap|14.7|48|84|132,Diner Hoodie|https://mazrood.com/cdn/shop/files/MZ-27_1_900x.jpg?v=1780383212|https://mazrood.com/products/mazrood-diner-hoodie|38.8|66|106|172,Peacemaker Cap|https://mazrood.com/cdn/shop/files/DSC06361Large_700x.jpg?v=1787983290|https://mazrood.com/products/peacemaker-cap|63.4|65|85|150,Warning: Closet Envy Cap|https://mazrood.com/cdn/shop/files/DSC06338Large_700x.jpg?v=1787982586|https://mazrood.com/products/warning-closet-envy-cap|87.2|46|86|132" | split: ',' -%}
    {%- for item in rope_items -%}
      {%- assign p = item | split: '|' -%}
      <div class="mz-rope-item" style="left:{{ p[3] }}%">
        <span class="mz-rope-line" style="top:{{ p[4] }}px;height:{{ p[5] }}px"></span>
        <span class="mz-rope-pin" style="top:{{ p[4] | minus: 6 }}px"></span>
        <a href="{{ p[2] }}" class="mz-rope-card" style="top:{{ p[6] }}px">
          <div><img src="{{ p[1] }}" alt="{{ p[0] }}" loading="lazy"></div>
          <p class="mz-rope-cap">{{ p[0] }}</p>
        </a>
      </div>
    {%- endfor -%}
  </div>
</section>