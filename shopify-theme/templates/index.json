    "manifesto": {
      "type": "mz-manifesto",
      "settings": {
        "eyebrow": "03 — Studio Manifesto",
        "line_1": "We don't chase",
        "line_bold": "trends.",
        "line_2": "We build",
        "line_3": "standards.",
        "body": "Mazrood is a studio before it is a label. We design quietly, produce slowly, and release only what we believe belongs in the wardrobe for years — not weeks."
      },
      "blocks": {
        "p1": { "type": "principle", "settings": { "n": "01", "title": "Cut with intent", "copy": "Every pattern starts as a question: what does this garment need to do — and nothing more. We strip until only the essential remains." } },
        "p2": { "type": "principle", "settings": { "n": "02", "title": "Built to outlast", "copy": "Seasons pass; the pieces stay. We choose fabrics and construction that age into character rather than out of relevance." } },
        "p3": { "type": "principle", "settings": { "n": "03", "title": "Made in the studio", "copy": "Nothing leaves the studio until we would wear it ourselves. Small runs, considered details, no shortcuts." } }
      },
