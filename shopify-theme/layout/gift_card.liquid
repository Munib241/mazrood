<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ 'Gift card' }} &ndash; {{ shop.name }}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Jost:wght@200;300;400;500;600;700&display=swap" rel="stylesheet">
  {{ content_for_header }}
  <style>
    :root {
      --page-bg: {{ settings.col_page_bg }};
      --text: {{ settings.col_text }};
      --headings: {{ settings.col_headings }};
      --links: {{ settings.col_links }};
      --border: {{ settings.col_border }};
      --btn-bg: {{ settings.col_btn_bg }};
      --btn-text: {{ settings.col_btn }};
    }
  </style>
  {{ 'theme.css' | asset_url | stylesheet_tag }}
</head>
<body>
  <main class="pw">
    {{ content_for_layout }}
  </main>
</body>
</html>