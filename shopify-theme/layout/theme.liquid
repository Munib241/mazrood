<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="{{ settings.col_page_bg }}">
  <link rel="canonical" href="{{ canonical_url }}">
  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | img_url: '32x32' }}">
  {%- endif -%}
  <title>
    {{ page_title }}
    {%- if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif -%}
    {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
  </title>
  {%- if page_description -%}
    <meta name="description" content="{{ page_description | escape }}">
  {%- endif -%}
  {% render 'meta-tags' %}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600;700&family=Archivo:wdth,wght@125,900&display=swap" rel="stylesheet">
  {{ content_for_header }}
  <style>
    :root {
      --page-bg: {{ settings.col_page_bg }};
      --text: {{ settings.col_text }};
      --headings: {{ settings.col_headings }};
      --links: {{ settings.col_links }};
      --border: {{ settings.col_border }};
      --btn-bg: {{ settings.col_btn_bg }};
      --btn-text: {{ settings.col_btn }};
      --announcement-bg: {{ settings.col_announcement_bg }};
      --announcement-text: {{ settings.col_announcement_text }};
      --footer-bg: {{ settings.col_footer_bg }};
      --footer-text: {{ settings.col_footer_text }};
      --sale: {{ settings.col_sale }};
      --sold: {{ settings.col_sold }};
      --new: {{ settings.col_new }};
      --surface: #fdfdfc;
      --font-head: 'Space Grotesk', sans-serif;
      --font-body: 'Inter', sans-serif;
    }
  </style>
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  {{ 'mz-ss26.css' | asset_url | stylesheet_tag }}
  {{ 'mz-product-card.css' | asset_url | stylesheet_tag }}
  <script>window.MZ_CURRENCY = {{ cart.currency.symbol | json }};</script>
  <script src="{{ 'theme.js' | asset_url }}" defer></script>
  <script src="{{ 'mz-product-card.js' | asset_url }}" defer></script>
</head>
<body class="template-{{ template.name }}">
  <a class="skip-link" href="#MainContent">Skip to content</a>

  {% sections 'header-group' %}

  <main id="MainContent" role="main">
    {{ content_for_layout }}
  </main>

  {% sections 'footer-group' %}

  <div id="CartDrawer" class="cd" aria-hidden="true">
    <div class="cd-backdrop" data-cd-close></div>
    <aside class="cd-panel" role="dialog" aria-label="Shopping cart">
      <header class="cd-head">
        <p class="cd-title">Your cart (<span data-cd-count>{{ cart.item_count }}</span>)</p>
        <button type="button" class="cd-close" data-cd-close aria-label="Close cart">&times;</button>
      </header>
      <div class="cd-items" data-cd-items></div>
      <footer class="cd-foot" data-cd-foot>
        <div class="cd-subtotal"><span>Subtotal</span><strong data-cd-subtotal>{{ cart.total_price | money }}</strong></div>
        <p class="cd-note">Taxes and shipping calculated at checkout</p>
        <a href="{{ routes.cart_url }}" class="cd-view-cart">View cart</a>
        <a href="/checkout" class="btn btn-solid cd-checkout">Checkout</a>
      </footer>
    </aside>
  </div>
</body>
</html>