<div class="announcement-bar">
  {%- for block in section.blocks -%}
    <p {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</p>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "Announcement bar",
  "max_blocks": 3,
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Free worldwide shipping on orders over $200"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [{ "type": "message" }]
    }
  ]
}
{% endschema %}