{%- liquid
  assign fc = collections[section.settings.collection]
  if fc == blank
    assign fc = collections.all
  endif
-%}

<section class="sec">
  <div class="container">
    <div class="sec-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="sec-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        {%- if section.settings.title != blank -%}<h2 class="sec-title">{{ section.settings.title }}</h2>{%- endif -%}
      </div>
      {%- if section.settings.show_view_all and fc != blank -%}
        <a href="{{ fc.url }}" class="sec-link">View all &rarr;</a>
      {%- endif -%}
    </div>
    <div class="prod-grid" style="grid-template-columns:repeat({{ section.settings.columns }},1fr)">
      {%- for product in fc.products limit: section.settings.count -%}
        {% render 'mz-product-card', product: product %}
      {%- else -%}
        <p class="sec-empty">Coming soon</p>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Mazrood Studio" },
    { "type": "text", "id": "title", "label": "Heading", "default": "End of Season" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "columns", "label": "Columns (desktop)", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "range", "id": "count", "label": "Products to show", "min": 2, "max": 24, "step": 1, "default": 8 },
    { "type": "checkbox", "id": "show_view_all", "label": "Show 'View all' link", "default": true }
  ],
  "presets": [
    { "name": "Featured collection" }
  ]
}
{% endschema %}