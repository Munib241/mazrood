<section class="order">
  <a href="{{ routes.account_url }}" class="auth-alt" style="margin:0">&larr; Back to account</a>
  <h1 class="sec-title" style="margin-top:12px">{{ order.name }}</h1>
  <p class="article-meta">{{ order.created_at | date: '%B %-d, %Y' }}</p>
  {%- if order.cancelled -%}
    <p class="nl-err">Order cancelled on {{ order.cancelled_at | date: '%B %-d, %Y' }} &mdash; {{ order.cancel_reason_label }}</p>
  {%- endif -%}

  <table class="account-table">
    <thead>
      <tr>
        <th scope="col">Product</th>
        <th scope="col">Qty</th>
        <th scope="col">Total</th>
      </tr>
    </thead>
    <tbody>
      {%- for line in order.line_items -%}
        <tr>
          <td>
            {{ line.title }}
            {%- if line.fulfillment -%}
              <br><span style="font-size:11px;opacity:.6">Fulfilled {{ line.fulfillment.created_at | date: '%b %-d' }}</span>
            {%- endif -%}
          </td>
          <td>{{ line.quantity }}</td>
          <td>{{ line.final_line_price | money }}</td>
        </tr>
      {%- endfor -%}
    </tbody>
  </table>

  <div class="cartp-foot" style="text-align:right;max-width:360px">
    <div class="cartp-subtotal"><span>Subtotal</span><strong>{{ order.subtotal_price | money }}</strong></div>
    <div class="cartp-subtotal"><span>Shipping</span><strong>{{ order.shipping_price | money }}</strong></div>
    {%- for tax_line in order.tax_lines -%}
      <div class="cartp-subtotal"><span>Tax ({{ tax_line.title }})</span><strong>{{ tax_line.price | money }}</strong></div>
    {%- endfor -%}
    <div class="cartp-subtotal"><span>Total</span><strong>{{ order.total_price | money }}</strong></div>
  </div>
</section>

{% schema %}
{
  "name": "Order",
  "settings": []
}
{% endschema %}