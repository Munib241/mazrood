<section class="mz mz-sec mzi" aria-labelledby="h-{{ section.id }}">
  <div class="mz-wrap mzi-wrap">
    <h2 id="h-{{ section.id }}" class="visually-hidden">About Mazrood</h2>
    <p class="mzi-en">{{ section.settings.intro_en | escape }}</p>
    <p class="mzi-ar" lang="ar" dir="rtl">{{ section.settings.intro_ar | escape }}</p>
  </div>
</section>

{% schema %}
{
  "name": "Brand intro",
  "settings": [
    { "type": "textarea", "id": "intro_en", "label": "Intro (English)", "default": "Mazrood is a Saudi casual formal brand, founded in Riyadh in 2016. Shop shirts, knitwear, jackets and everyday essentials. Shown at Riyadh Fashion Week." },
    { "type": "textarea", "id": "intro_ar", "label": "Intro (Arabic, right to left)", "default": "مزرود علامة سعودية للأزياء الكاجوال الفورمال، تأسست في الرياض عام 2016. تسوق القمصان والتريكو والجاكيتات والأساسيات اليومية." }
  ],
  "presets": [{ "name": "Brand intro" }]
}
{% endschema %}