<section class="mz mz-sec{% if section.settings.rule %} mz-sec--rule{% endif %}"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor | handleize }}"{% endif %} aria-labelledby="h-{{ section.id }}">
  <div class="mz-wrap">
    <div class="mzp-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="mz-eye">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 id="h-{{ section.id }}" class="mz-h2">{{ section.settings.title }} <b>{{ section.settings.title_bold }}</b></h2>
      </div>
      {%- if section.settings.link_label != blank -%}
        <a href="{{ section.settings.link_url }}" class="mzp-all">{{ section.settings.link_label }}{% render 'mz-icon', name: 'arrow-up-right', size: 14 %}</a>
      {%- endif -%}
    </div>

    <div class="mzp-grid">
      {%- liquid
        if section.settings.products != blank
          for product in section.settings.products limit: section.settings.count
            render 'mz-card', product: product, style: section.settings.style
          endfor
        elsif section.settings.collection != blank
          for product in section.settings.collection.products limit: section.settings.count
            render 'mz-card', product: product, style: section.settings.style
          endfor
        endif
      -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product row",
  "settings": [
    { "type": "select", "id": "style", "label": "Card style", "options": [ { "value": "new", "label": "New arrivals" }, { "value": "sale", "label": "Sale" } ], "default": "new" },
    { "type": "text", "id": "anchor", "label": "Section anchor", "default": "new" },
    { "type": "checkbox", "id": "rule", "label": "Divider line above", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "03 — New Arrivals" },
    { "type": "text", "id": "title", "label": "Title", "default": "SS26, fresh" },
    { "type": "text", "id": "title_bold", "label": "Title (bold)", "default": "from the studio." },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "View All" },
    { "type": "text", "id": "link_url", "label": "Link", "default": "/collections/new-2026" },
    { "type": "product_list", "id": "products", "label": "Products", "limit": 16 },
    { "type": "collection", "id": "collection", "label": "Collection (used when no products are picked)" },
    { "type": "range", "id": "count", "label": "Products to show", "min": 4, "max": 16, "step": 1, "default": 8 }
  ],
  "presets": [{ "name": "Product row" }]
}
{% endschema %}