<div class="password-wordmark">
  {{ settings.logo_text | default: shop.name }}{%- if settings.logo_show_tm -%}<sup style="font-size: 0.4em; vertical-align: top;">™</sup>{%- endif -%}
</div>

{%- if shop.password_message != blank -%}
  <p style="color: var(--muted); margin-top: 14px;">{{ shop.password_message }}</p>
{%- endif -%}

{%- form 'storefront_password', class: 'password-form' -%}
  <input type="password" name="password" placeholder="Enter store password" aria-label="Store password" required>
  <button type="submit" class="btn btn-solid">Enter</button>
  {%- if form.errors -%}
    <p style="color: var(--muted);">Wrong password, try again.</p>
  {%- endif -%}
{%- endform -%}

{% schema %}
{
  "name": "Password",
  "settings": []
}
{% endschema %}