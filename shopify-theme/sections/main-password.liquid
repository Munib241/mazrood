<section class="pw-inner">
  <span class="pw-wordmark">{{ section.settings.logo_text | escape }}<sup style="font-size:.4em;letter-spacing:0">{{ section.settings.logo_tm | escape }}</sup></span>
  <p class="pw-msg" style="margin-bottom:20px">{{ section.settings.message }}</p>
  {%- form 'storefront_password' -%}
    {%- if form.errors -%}
      <p class="nl-err">Incorrect password</p>
    {%- endif -%}
    <div class="pw-form">
      <input type="password" name="password" placeholder="Enter store password" aria-label="Store password" required>
      <button type="submit" class="btn btn-solid">Enter</button>
    </div>
  {%- endform -%}
  <p class="pw-admin">Are you the store owner? <a href="/admin">Log in here</a></p>
</section>

{% schema %}
{
  "name": "Password",
  "settings": [
    { "type": "text", "id": "logo_text", "label": "Wordmark text", "default": "MAZROOD" },
    { "type": "text", "id": "logo_tm", "label": "Trademark mark", "default": "™" },
    { "type": "text", "id": "message", "label": "Message", "default": "Opening soon. Enter the store password to continue." }
  ]
}
{% endschema %}