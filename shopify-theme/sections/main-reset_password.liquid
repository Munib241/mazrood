<section class="auth">
  <div class="auth-card">
    <h1 class="sec-title">Reset password</h1>
    <p class="auth-alt" style="margin:0 0 18px">Enter a new password</p>
    {%- form 'reset_customer_password' -%}
      {%- if form.errors -%}
        <p class="nl-err">{{ form.errors | default_errors }}</p>
      {%- endif -%}
      <div class="field">
        <label for="rpPassword">Password</label>
        <input id="rpPassword" type="password" name="customer[password]" required autocomplete="new-password">
      </div>
      <div class="field">
        <label for="rpConfirm">Confirm password</label>
        <input id="rpConfirm" type="password" name="customer[password_confirmation]" required autocomplete="new-password">
      </div>
      <button type="submit" class="btn btn-solid">Reset password</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Reset password",
  "settings": []
}
{% endschema %}