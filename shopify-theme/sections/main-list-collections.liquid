<section class="container sec">
  <div class="sec-head">
    <div>
      <p class="sec-eyebrow">Browse</p>
      <h1 class="sec-title">Collections</h1>
    </div>
  </div>
  <div class="lc-grid">
    {%- for collection in collections -%}
      <a href="{{ collection.url }}" class="cl-card">
        <div class="cl-img">
          {%- if collection.featured_image -%}
            <img src="{{ collection.featured_image | img_url: '700x' }}" alt="{{ collection.title | escape }}" loading="lazy">
          {%- endif -%}
        </div>
        <p class="cl-name">{{ collection.title }}</p>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Collections list",
  "settings": []
}
{% endschema %}