<section class="mz mz-sec mz-sec--rule" id="look" aria-labelledby="h-{{ section.id }}">
  <div class="mz-wrap">
    <div class="mzl-head">
      {%- if section.settings.eyebrow != blank -%}<p class="mz-eye">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 id="h-{{ section.id }}" class="mz-h2">{{ section.settings.title }} <b>{{ section.settings.title_bold }}</b></h2>
    </div>

    <div class="mzl-rows">
      {%- for block in section.blocks -%}
        {%- liquid
          assign p = block.settings.product
          assign href = block.settings.url
          if p != blank
            assign href = p.url
          endif
          assign odd = forloop.index0 | modulo: 2
        -%}
        <div class="mzl-row{% if odd == 1 %} mzl-row--flip{% endif %}" {{ block.shopify_attributes }}>
          <div class="mzl-media">
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 1400 }}" alt="{{ block.settings.title | escape }} — Mazrood studio look." loading="lazy">
            {%- elsif block.settings.image_src != blank -%}
              <img src="{{ block.settings.image_src }}" alt="{{ block.settings.title | escape }} — Mazrood studio look." loading="lazy">
            {%- elsif p != blank and p.featured_image -%}
              <img src="{{ p.featured_image | image_url: width: 1400 }}" alt="{{ block.settings.title | escape }} — Mazrood studio look." loading="lazy">
            {%- endif -%}
          </div>
          <div class="mzl-text">
            {%- if block.settings.tag != blank -%}<p class="mzl-tag">{{ block.settings.tag }}</p>{%- endif -%}
            <h3 class="mzl-title">{{ block.settings.title }}</h3>
            {%- if block.settings.copy != blank -%}<p class="mzl-copy">{{ block.settings.copy }}</p>{%- endif -%}
            {%- if block.settings.cta != blank and href != blank -%}
              <a href="{{ href }}" class="mz-btn mz-btn--ghost">{{ block.settings.cta }}{% render 'mz-icon', name: 'arrow-right', size: 14 %}</a>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "The look",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "04 — The Look" },
    { "type": "text", "id": "title", "label": "Title", "default": "Worn well." },
    { "type": "text", "id": "title_bold", "label": "Title (bold)", "default": "Shot on location." }
  ],
  "blocks": [
    {
      "type": "look",
      "name": "Look",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_src", "label": "Image URL (used when no image is picked)" },
        { "type": "text", "id": "tag", "label": "Tag", "default": "SS26 — Men" },
        { "type": "text", "id": "title", "label": "Title", "default": "Mzrd Tencel Shirt" },
        { "type": "textarea", "id": "copy", "label": "Copy" },
        { "type": "text", "id": "cta", "label": "Button label", "default": "Shop the Look" },
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "url", "label": "Link (used when no product is picked)" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    { "name": "The look", "blocks": [{ "type": "look" }, { "type": "look" }] }
  ]
}
{% endschema %}