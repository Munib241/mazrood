{%- liquid
  assign over = false
  if template.name == 'index' and section.settings.transparent_on_home
    assign over = true
  endif
  if customer
    assign account_url = routes.account_url
  else
    assign account_url = routes.account_login_url
  endif
-%}
<header class="mz mzn{% if over %} mzn--over{% endif %}" id="SiteHeader">
  <div class="mzn-bar">
    <nav class="mzn-inner" aria-label="Main navigation">
      <a href="{{ routes.root_url }}" class="mzn-logo" aria-label="{{ shop.name | escape }} home">
        <span class="mz-wordmark">{{ section.settings.logo_text | escape }}<sup aria-hidden="true">{{ section.settings.logo_tm | escape }}</sup></span>
      </a>

      <div class="mzn-links">
        {%- for link in section.settings.menu.links -%}
          {%- if link.links.size > 0 -%}
            <div class="mzn-item">
              <a href="{{ link.url }}" class="mzn-link" aria-haspopup="true">{{ link.title }}{% render 'mz-icon', name: 'chevron-down', size: 14 %}</a>
              <div class="mzn-drop">
                <div class="mzn-drop-panel">
                  <a href="{{ link.url }}" class="is-accent">Shop all {{ link.title }}</a>
                  {%- for child in link.links -%}
                    {%- assign child_title = child.title | downcase -%}
                    {%- unless child_title == 'all' -%}<a href="{{ child.url }}">{{ child.title }}</a>{%- endunless -%}
                  {%- endfor -%}
                </div>
              </div>
            </div>
          {%- else -%}
            <a href="{{ link.url }}" class="mzn-link">{{ link.title }}</a>
          {%- endif -%}
        {%- endfor -%}
        <a href="{{ routes.cart_url }}" class="mzn-icon" data-cart-open aria-label="Cart">
          {%- render 'mz-icon', name: 'cart', size: 17 -%}
          <span class="mzn-count" data-cart-count{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span>
        </a>
        {%- if shop.customer_accounts_enabled -%}
          <a href="{{ account_url }}" class="mzn-icon" aria-label="Account">{% render 'mz-icon', name: 'settings', size: 17 %}</a>
        {%- endif -%}
      </div>

      <div class="mzn-mob">
        <a href="{{ routes.cart_url }}" class="mzn-icon" data-cart-open aria-label="Cart">
          {%- render 'mz-icon', name: 'cart', size: 20 -%}
          <span class="mzn-count" data-cart-count{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span>
        </a>
        <button type="button" class="mzn-icon mzn-burger" data-nav-toggle aria-label="Toggle menu" aria-expanded="false">
          {%- render 'mz-icon', name: 'menu', size: 22, class: 'mzn-bars' -%}
          {%- render 'mz-icon', name: 'x', size: 22, class: 'mzn-x' -%}
        </button>
      </div>
    </nav>

    <div class="mzn-menu">
      {%- for link in section.settings.menu.links -%}
        {%- if link.links.size > 0 -%}
          <details>
            <summary class="mzn-row">{{ link.title }}{% render 'mz-icon', name: 'chevron-down', size: 16 %}</summary>
            <div class="mzn-sub">
              <a href="{{ link.url }}" class="is-accent">Shop all {{ link.title }}</a>
              {%- for child in link.links -%}
                {%- assign child_title = child.title | downcase -%}
                {%- unless child_title == 'all' -%}<a href="{{ child.url }}">{{ child.title }}</a>{%- endunless -%}
              {%- endfor -%}
            </div>
          </details>
        {%- else -%}
          <a href="{{ link.url }}" class="mzn-row">{{ link.title }}</a>
        {%- endif -%}
      {%- endfor -%}
      {%- if shop.customer_accounts_enabled -%}
        <a href="{{ account_url }}" class="mzn-row mzn-row--last">Account</a>
      {%- endif -%}
    </div>
  </div>
</header>

<nav class="mz mzt" aria-label="Primary mobile navigation">
  <div class="mzt-inner">
    <a href="{{ routes.root_url }}" class="{% if template.name == 'index' %}is-on{% endif %}" aria-label="Home">
      {%- render 'mz-icon', name: 'home', size: 20 -%}<span>Home</span>
    </a>
    <a href="{{ section.settings.tab_new_url }}" class="{% if request.path == section.settings.tab_new_url %}is-on{% endif %}" aria-label="New arrivals">
      {%- render 'mz-icon', name: 'sparkles', size: 20 -%}<span>New</span>
    </a>
    <a href="{{ section.settings.tab_sale_url }}" class="{% if request.path == section.settings.tab_sale_url %}is-on{% endif %}" aria-label="Archive">
      {%- render 'mz-icon', name: 'tag', size: 20 -%}<span>Archive</span>
    </a>
    <a href="{{ account_url }}" class="{% if template.name contains 'customers' %}is-on{% endif %}" aria-label="Account">
      {%- render 'mz-icon', name: 'user', size: 20 -%}<span>Account</span>
    </a>
  </div>
</nav>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "text", "id": "logo_text", "label": "Wordmark text", "default": "MAZROOD" },
    { "type": "text", "id": "logo_tm", "label": "Trademark mark", "default": "TM" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "checkbox", "id": "transparent_on_home", "label": "Transparent over the home hero", "default": true },
    { "type": "header", "content": "Mobile bottom tabs" },
    { "type": "text", "id": "tab_new_url", "label": "New tab link", "default": "/collections/new-2026" },
    { "type": "text", "id": "tab_sale_url", "label": "Archive tab link", "default": "/collections/fw25-26" }
  ]
}
{% endschema %}