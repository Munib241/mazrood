<header class="site-header">
  <div class="page-width">
    <nav class="header-inner" aria-label="Main navigation">
      <a href="{{ routes.root_url }}" class="wordmark" aria-label="{{ shop.name | escape }} home">
        {%- if settings.logo != blank -%}
          {{ settings.logo | image_url: width: 300 | image_tag: alt: shop.name }}
        {%- else -%}
          {{ settings.logo_text | default: shop.name }}{%- if settings.logo_show_tm -%}<sup>™</sup>{%- endif -%}
        {%- endif -%}
      </a>

      <div class="header-nav">
        {%- for link in section.settings.menu.links -%}
          <div class="nav-item">
            <a href="{{ link.url }}" {% if link.current %}aria-current="page"{% endif %}>{{ link.title }}</a>
            {%- if link.links.size > 0 -%}
              <div class="nav-dropdown">
                {%- for child in link.links -%}
                  <a href="{{ child.url }}">{{ child.title }}</a>
                {%- endfor -%}
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>

      <div class="header-actions">
        <a href="{{ routes.search_url }}" aria-label="Search">Search</a>
        <a href="{{ routes.cart_url }}" aria-label="Cart">
          Cart <span class="cart-count" data-cart-count>{{ cart.item_count }}</span>
        </a>
        <button
          type="button"
          class="menu-toggle"
          data-menu-toggle
          aria-controls="MobileNav"
          aria-expanded="false"
          aria-label="Menu"
        >
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        </button>
      </div>
    </nav>

    <nav class="mobile-nav" id="MobileNav" aria-label="Mobile navigation">
      {%- for link in section.settings.menu.links -%}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {%- endfor -%}
      <a href="{{ routes.search_url }}">Search</a>
    </nav>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}