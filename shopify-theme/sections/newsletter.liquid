<section class="section section--tight newsletter">
  <div class="page-width">
    <span class="eyebrow">{{ section.settings.eyebrow | escape | default: 'Newsletter' }}</span>
    <h2>{{ section.settings.heading | escape | default: 'Join the list' }}</h2>
    <p>{{ section.settings.text | escape | default: 'Early access to drops, restocks and private sales.' }}</p>

    {%- form 'customer', class: 'newsletter-form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <input
        type="email"
        name="contact[email]"
        placeholder="Email address"
        aria-label="Email address"
        required
        {% if form.posted_successfully? %}autofocus{% endif %}
      >
      <button type="submit" class="btn btn-solid">Subscribe</button>
      {%- if form.posted_successfully? -%}
        <p class="newsletter-success">You're on the list.</p>
      {%- elsif form.errors -%}
        <p style="color: var(--muted);">{{ form.errors.messages.form }}</p>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow label", "default": "Newsletter" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join the list" },
    { "type": "text", "id": "text", "label": "Text", "default": "Early access to drops, restocks and private sales." }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}