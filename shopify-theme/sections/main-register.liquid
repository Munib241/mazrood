<section class="auth">
  <div class="auth-card">
    <h1 class="sec-title">Create account</h1>
    {%- form 'create_customer', novalidate: 'novalidate' -%}
      {%- if form.errors -%}
        <p class="nl-err">{{ form.errors | default_errors }}</p>
      {%- endif -%}
      <div class="field">
        <label for="crFirst">First name</label>
        <input id="crFirst" type="text" name="customer[first_name]" autocomplete="given-name">
      </div>
      <div class="field">
        <label for="crLast">Last name</label>
        <input id="crLast" type="text" name="customer[last_name]" autocomplete="family-name">
      </div>
      <div class="field">
        <label for="crEmail">Email</label>
        <input id="crEmail" type="email" name="customer[email]" required autocomplete="email">
      </div>
      <div class="field">
        <label for="crPassword">Password</label>
        <input id="crPassword" type="password" name="customer[password]" required autocomplete="new-password">
      </div>
      <button type="submit" class="btn btn-solid">Create account</button>
    {%- endform -%}
    <p class="auth-alt">Already have an account? <a href="{{ routes.account_login_url }}">Sign in</a></p>
  </div>
</section>

{% schema %}
{
  "name": "Register",
  "settings": []
}
{% endschema %}