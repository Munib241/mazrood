<footer class="ft">
  <div class="ft-inner">
    <div class="ft-brand">
      <span class="ft-wordmark">{{ section.settings.logo_text | escape }}<sup>{{ section.settings.logo_tm | escape }}</sup></span>
      {%- if section.settings.blurb != blank -%}
        <p class="ft-blurb">{{ section.settings.blurb }}</p>
      {%- endif -%}
      <div class="ft-social">
        {%- if settings.social_instagram != blank -%}<a href="{{ settings.social_instagram }}" target="_blank" rel="noopener">Instagram</a>{%- endif -%}
        {%- if settings.social_tiktok != blank -%}<a href="{{ settings.social_tiktok }}" target="_blank" rel="noopener">TikTok</a>{%- endif -%}
        {%- if settings.social_facebook != blank -%}<a href="{{ settings.social_facebook }}" target="_blank" rel="noopener">Facebook</a>{%- endif -%}
        {%- if settings.social_pinterest != blank -%}<a href="{{ settings.social_pinterest }}" target="_blank" rel="noopener">Pinterest</a>{%- endif -%}
        {%- if settings.social_whatsapp != blank -%}
          <a href="{% unless settings.social_whatsapp contains 'http' %}https://wa.me/{{ settings.social_whatsapp | remove: '+' }}{% endunless %}" target="_blank" rel="noopener">WhatsApp</a>
        {%- endif -%}
      </div>
    </div>

    {%- for block in section.blocks -%}
      <div class="ft-col" {{ block.shopify_attributes }}>
        <p class="ft-head">{{ block.settings.title | escape }}</p>
        <ul>
          {%- for link in block.settings.menu.links -%}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endfor -%}

    <div class="ft-news">
      <p class="ft-head">Newsletter</p>
      {%- form 'customer' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input type="email" name="contact[email]" placeholder="Email address" required autocomplete="email" aria-label="Email address">
        {%- if form.posted_successfully? -%}
          <p class="ft-ok">Thank you for subscribing.</p>
        {%- else -%}
          <button type="submit" class="btn btn-solid">Subscribe</button>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>

  <div class="ft-bottom">
    <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</p>
    <div class="ft-bottom-links">
      {%- for policy in shop.policies -%}
        {%- if policy != blank -%}<a href="{{ policy.url }}">{{ policy.title }}</a>{%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "text", "id": "logo_text", "label": "Wordmark text", "default": "MAZROOD" },
    { "type": "text", "id": "logo_tm", "label": "Trademark mark", "default": "™" },
    { "type": "textarea", "id": "blurb", "label": "Blurb", "default": "New-season streetwear, knits and headwear. Designed for the season, made to last." }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        { "type": "text", "id": "title", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        { "type": "menu" }
      ]
    }
  ]
}
{% endschema %}