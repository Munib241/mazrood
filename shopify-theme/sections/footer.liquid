<footer class="mz mzf" id="contact" aria-labelledby="h-{{ section.id }}">
  <div class="mzf-sheen" aria-hidden="true"></div>
  <div class="mzf-dim" aria-hidden="true"></div>

  <div class="mz-wrap mzf-inner">
    {%- if section.settings.eyebrow != blank -%}<p class="mz-eye">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 id="h-{{ section.id }}" class="mzf-title">{{ section.settings.title }} <em>{{ section.settings.title_bold }}</em></h2>
    {%- if section.settings.body != blank -%}<p class="mzf-sub">{{ section.settings.body }}</p>{%- endif -%}

    {%- form 'customer', id: 'mzf-signup', class: 'mzf-form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <label for="mzf-email" class="visually-hidden">Email address</label>
      <div class="mzf-field">
        <input id="mzf-email" class="mzf-input" type="email" name="contact[email]" placeholder="{{ section.settings.placeholder | escape }}" required autocomplete="email">
        <button type="submit" class="mz-btn mz-btn--solid">
          {%- if form.posted_successfully? -%}
            {%- render 'mz-icon', name: 'check', size: 14 -%} You're in
          {%- else -%}
            {{ section.settings.button }}{% render 'mz-icon', name: 'arrow-right', size: 14 %}
          {%- endif -%}
        </button>
      </div>
      {%- if form.errors -%}
        <p class="mzf-note mzf-note--err" role="alert">Could not sign you up — please try again.</p>
      {%- else -%}
        <p class="mzf-note">{{ section.settings.note }}</p>
      {%- endif -%}
    {%- endform -%}

    <div class="mzf-bottom">
      <div class="mzf-brand">
        <span class="mzf-dot"></span>
        <span class="mzf-brand-name">{{ section.settings.brand }}</span>
      </div>
      <nav class="mzf-nav" aria-label="Collections">
        {%- for block in section.blocks -%}
          {%- if block.type == 'collection_link' -%}
            <a href="{{ block.settings.href }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
          {%- endif -%}
        {%- endfor -%}
      </nav>
    </div>

    <nav class="mzf-nav mzf-support" aria-label="Support and policies">
      <span class="mzf-support-label">Support</span>
      {%- for block in section.blocks -%}
        {%- if block.type == 'support_link' -%}
          <a href="{{ block.settings.href }}"{% if block.settings.accent %} class="is-accent"{% endif %} {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
        {%- endif -%}
      {%- endfor -%}
    </nav>

    <p class="mzf-copy">&copy; {{ 'now' | date: '%Y' }} {{ section.settings.copyright }}</p>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "06 — Stay in the loop" },
    { "type": "text", "id": "title", "label": "Title", "default": "Join" },
    { "type": "text", "id": "title_bold", "label": "Title (bold italic)", "default": "the list." },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Early access to new-season drops and notes from the studio." },
    { "type": "text", "id": "placeholder", "label": "Email placeholder", "default": "your@email.com" },
    { "type": "text", "id": "button", "label": "Button label", "default": "Sign Up" },
    { "type": "text", "id": "note", "label": "Note under the field", "default": "News and offers only. Unsubscribe anytime." },
    { "type": "text", "id": "brand", "label": "Brand name", "default": "Mazrood Studio" },
    { "type": "text", "id": "copyright", "label": "Copyright text", "default": "Mazrood Studio — All rights reserved" }
  ],
  "blocks": [
    {
      "type": "collection_link",
      "name": "Collection link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "New" },
        { "type": "text", "id": "href", "label": "Link", "default": "/collections/all" }
      ]
    },
    {
      "type": "support_link",
      "name": "Support link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Shipping & Returns" },
        { "type": "text", "id": "href", "label": "Link", "default": "/policies/shipping-policy" },
        { "type": "checkbox", "id": "accent", "label": "Highlight in brass", "default": false }
      ]
    }
  ],
  "presets": [{ "name": "Footer" }]
}
{% endschema %}