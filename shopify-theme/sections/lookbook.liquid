<section class="section">
  <div class="page-width">
    <div class="section-head">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}
      <h2>{{ section.settings.heading | escape | default: 'The look' }}</h2>
    </div>

    <div class="look-grid">
      {%- for block in section.blocks -%}
        <div class="look {% cycle '', 'look--flip' %}" {{ block.shopify_attributes }}>
          <div class="look-media">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', alt: block.settings.heading | escape }}
            {%- endif -%}
          </div>
          <div class="look-copy">
            {%- if block.settings.eyebrow != blank -%}
              <span class="eyebrow">{{ block.settings.eyebrow | escape }}</span>
            {%- endif -%}
            <h2>{{ block.settings.heading | escape }}</h2>
            <p>{{ block.settings.text | escape }}</p>
            {%- if block.settings.link_label != blank -%}
              <a href="{{ block.settings.link | default: routes.all_products_collection_url }}" class="btn btn-ghost">
                {{ block.settings.link_label | escape }}
              </a>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Lookbook",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow label", "default": "Editorial" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The look" }
  ],
  "blocks": [
    {
      "type": "look",
      "name": "Look",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow label", "default": "Look 01" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Obsidian work jacket" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Cut from technical twill with a sculpted drape, finished in matte black hardware." },
        { "type": "text", "id": "link_label", "label": "Button label", "default": "Shop the look" },
        { "type": "url", "id": "link", "label": "Button link" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Lookbook",
      "blocks": [{ "type": "look" }, { "type": "look" }]
    }
  ]
}
{% endschema %}