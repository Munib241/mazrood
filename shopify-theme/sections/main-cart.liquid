<section class="container cartp">
  <h1 class="sec-title">Your cart</h1>

  {%- if cart.item_count == 0 -%}
    <p>Your cart is empty. <a href="{{ routes.all_products_collection_url }}">Continue shopping</a></p>
  {%- else -%}
    <form action="{{ routes.cart_url }}" method="post" novalidate>
      <div class="cartp-rows">
        {%- for item in cart.items -%}
          <div class="cartp-row">
            <a href="{{ item.url }}" class="cartp-img">
              <img src="{{ item.image | img_url: '220x' }}" alt="{{ item.title | escape }}" loading="lazy">
            </a>
            <div class="cartp-info">
              <a href="{{ item.url }}" class="cartp-title">{{ item.product.title }}</a>
              {%- unless item.product.has_only_default_variant -%}
                <p class="cartp-variant">{{ item.variant.title }}</p>
              {%- endunless -%}
              <p class="cartp-price">{{ item.final_price | money }}</p>
            </div>
            <div class="cartp-qty">
              <label for="CartQty{{ forloop.index }}" class="visually-hidden">Quantity</label>
              <input id="CartQty{{ forloop.index }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0" inputmode="numeric">
            </div>
            <p class="cartp-total">{{ item.final_line_price | money }}</p>
          </div>
        {%- endfor -%}
      </div>

      <div class="cartp-foot">
        <div class="cartp-subtotal">
          <span>Subtotal</span>
          <strong>{{ cart.total_price | money }}</strong>
        </div>
        <p class="cartp-note">Taxes and shipping calculated at checkout</p>
        <button type="submit" name="update" class="btn btn-ghost2">Update cart</button>
        <button type="submit" name="checkout" class="btn btn-solid">Checkout</button>
      </div>
    </form>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Cart",
  "settings": []
}
{% endschema %}