{%- liquid
  assign v = product.selected_or_first_available_variant
-%}
<div class="page-width product-page">
  <div class="product-gallery">
    {%- for media in product.media -%}
      {%- if media.media_type == 'image' -%}
        {{ media | image_url: width: 1400 | image_tag: class: 'product-photo', loading: 'lazy', alt: media.alt | default: product.title | escape }}
      {%- else -%}
        {{ media | media_tag: image_size: '1200x' }}
      {%- endif -%}
    {%- else -%}
      <div class="product-photo"></div>
    {%- endfor -%}
  </div>

  <div class="product-info">
    <span class="eyebrow">{{ product.vendor | default: 'Mazrood Studio' }}</span>
    <h1>{{ product.title }}</h1>

    <p class="product-price">
      {%- if v.compare_at_price > v.price -%}
        {{ v.price | money }}
        <s>{{ v.compare_at_price | money }}</s>
      {%- else -%}
        {{ v.price | money }}
      {%- endif -%}
    </p>

    {%- if product.available -%}
      <p class="stock-note stock-note--in">In stock</p>
    {%- else -%}
      <p class="stock-note stock-note--out">Currently sold out</p>
    {%- endif -%}

    <div class="product-desc rte">{{ product.description }}</div>

    {%- form 'product', product, class: 'product-buy' -%}
      {%- unless product.has_only_default_variant -%}
        <div class="variant-field">
          <label for="VariantSelect-{{ section.id }}">Option</label>
          <select id="VariantSelect-{{ section.id }}" name="id" class="variant-select">
            {%- for variant in product.variants -%}
              <option
                value="{{ variant.id }}"
                {% if variant == v %}selected{% endif %}
                {% unless variant.available %}disabled{% endunless %}
              >
                {{ variant.title }} — {{ variant.price | money }}{% unless variant.available %} (sold out){% endunless %}
              </option>
            {%- endfor -%}
          </select>
        </div>
      {%- else -%}
        <input type="hidden" name="id" value="{{ v.id }}">
      {%- endunless -%}

      <div class="qty-field">
        <label for="Quantity-{{ section.id }}">Quantity</label>
        <input
          id="Quantity-{{ section.id }}"
          class="qty-input"
          type="number"
          name="quantity"
          value="1"
          min="1"
          max="10"
        >
      </div>

      <button type="submit" class="btn btn-solid" {% unless product.available %}disabled{% endunless %}>
        {%- if product.available -%}Add to cart{%- else -%}Sold out{%- endif -%}
      </button>
      {{ form | payment_button }}
    {%- endform -%}

    <p class="secure-note">Secure checkout</p>
  </div>
</div>

{% schema %}
{
  "name": "Product",
  "settings": []
}
{% endschema %}