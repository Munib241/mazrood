{%- assign current_variant = product.selected_or_first_available_variant -%}

<section class="container">
  <div class="pp">
    <div class="pp-gallery" data-pp-gallery>
      <div class="pp-main-img">
        <div class="pp-track" data-pp-track>
          {%- for media in product.media -%}
            <div class="pp-slide" data-media-id="{{ media.id }}">
              <img src="{{ media.preview_image | img_url: '1200x' }}"
                   alt="{{ media.alt | default: product.title | escape }}"
                   draggable="false">
            </div>
          {%- else -%}
            <div class="pp-slide">{{ 'product-1' | placeholder_svg_tag: 'pp-placeholder' }}</div>
          {%- endfor -%}
        </div>
        {%- if product.media.size > 1 -%}
          <button type="button" class="pp-nav pp-nav--prev" data-pp-prev aria-label="Previous photo">
            {%- render 'mz-icon', name: 'arrow-left', size: 18 -%}
          </button>
          <button type="button" class="pp-nav pp-nav--next" data-pp-next aria-label="Next photo">
            {%- render 'mz-icon', name: 'arrow-right', size: 18 -%}
          </button>
          <span class="pp-count" data-pp-count>1 / {{ product.media.size }}</span>
        {%- endif -%}
      </div>
      {%- if product.media.size > 1 -%}
        <div class="pp-dots">
          {%- for media in product.media -%}
            <button type="button"
                    class="pp-dot{% if forloop.first %} is-on{% endif %}"
                    data-pp-dot="{{ forloop.index0 }}"
                    aria-label="View photo {{ forloop.index }}"></button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="pp-info">
      {%- if section.settings.show_vendor and product.vendor != blank -%}
        <p class="pp-vendor">{{ product.vendor }}</p>
      {%- endif -%}
      <h1 class="pp-title">{{ product.title }}</h1>
      <p class="pp-price">
        <span data-pp-price>{{ current_variant.price | money }}</span>
        {%- if current_variant.compare_at_price > current_variant.price -%}
          <s class="pp-compare" data-pp-compare>{{ current_variant.compare_at_price | money }}</s>
        {%- endif -%}
      </p>

      {%- form 'product', product, id: 'ppForm' -%}
        <input type="hidden" name="id" value="{{ current_variant.id }}" data-pp-id>
        {%- unless product.has_only_default_variant -%}
          <div class="pp-options">
            {%- for option in product.options_with_values -%}
              {%- assign oname = option.name | downcase -%}
              {%- if oname contains 'color' or oname contains 'colour' -%}
                <div class="pp-opt" data-pp-group="{{ forloop.index0 }}">
                  <label>{{ option.name | escape }}: <span data-pp-opt-value>{{ option.selected_value }}</span></label>
                  <div class="pp-swatches">
                    {%- for value in option.values -%}
                      <button type="button"
                              class="pp-sw{% if option.selected_value == value %} is-on{% endif %}"
                              data-pp-value="{{ value | escape }}"
                              data-pp-option-index="{{ forloop.parentloop.index0 }}"
                              title="{{ value | escape }}"
                              aria-label="{{ value | escape }}">
                        <span class="pp-sw-dot"></span>
                      </button>
                    {%- endfor -%}
                  </div>
                </div>
              {%- else -%}
                <div class="pp-opt" data-pp-group="{{ forloop.index0 }}">
                  <label>{{ option.name | escape }}</label>
                  <div class="pp-sizes">
                    {%- for value in option.values -%}
                      <button type="button"
                              class="pp-size{% if option.selected_value == value %} is-on{% endif %}"
                              data-pp-value="{{ value | escape }}"
                              data-pp-option-index="{{ forloop.parentloop.index0 }}">{{ value }}</button>
                    {%- endfor -%}
                  </div>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endunless -%}
        <div class="pp-qty">
          <label for="ppQty">Quantity</label>
          <input id="ppQty" type="number" name="quantity" value="1" min="1" inputmode="numeric">
        </div>
        <p class="pp-stock" data-pp-stock>{%- if current_variant.available -%}In stock{%- else -%}Sold out{%- endif -%}</p>
        <button type="submit" name="add" class="btn btn-solid pp-add"{% unless current_variant.available %} disabled{% endunless %} data-pp-add>
          {%- if current_variant.available -%}Add to cart{%- else -%}Sold out{%- endif -%}
        </button>
      {%- endform -%}

      {%- if product.description != blank -%}
        <div class="pp-desc rte">{{ product.description }}</div>
      {%- endif -%}
    </div>
  </div>
</section>

<script type="application/json" data-pp-variants>{{ product.variants | json }}</script>
{% schema %}
{
  "name": "Product",
  "settings": [
    { "type": "checkbox", "id": "show_vendor", "label": "Show vendor", "default": false }
  ]
}
{% endschema %}