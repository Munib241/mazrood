<section class="mz mzh" id="top" data-mzh>
  <div class="mzh-img">
    {%- if section.settings.image != blank -%}
      <img src="{{ section.settings.image | image_url: width: 2400 }}" alt="{{ section.settings.title | escape }} {{ section.settings.title_bold | escape }}" fetchpriority="high">
    {%- elsif section.settings.image_src != blank -%}
      <img src="{{ section.settings.image_src }}" alt="{{ section.settings.title | escape }} {{ section.settings.title_bold | escape }}" fetchpriority="high">
    {%- endif -%}
  </div>
  <div class="mzh-glow" aria-hidden="true"></div>
  <div class="mzh-shade" aria-hidden="true"></div>

  {%- if section.settings.tag != blank -%}
    <div class="mzh-tag"><p class="mz-eye">{{ section.settings.tag }}</p></div>
  {%- endif -%}

  <div class="mzh-body">
    {%- if section.settings.eyebrow != blank -%}<p class="mz-eye">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h1 class="mzh-title">{{ section.settings.title }} <em>{{ section.settings.title_bold }}</em></h1>
    {%- if section.settings.desc != blank -%}<p class="mzh-desc">{{ section.settings.desc }}</p>{%- endif -%}
    <div class="mzh-ctas">
      {%- if section.settings.cta1 != blank -%}
        <a href="{{ section.settings.cta1_url }}" class="mz-btn mz-btn--solid">{{ section.settings.cta1 }}</a>
      {%- endif -%}
      {%- if section.settings.cta2 != blank -%}
        <a href="{{ section.settings.cta2_url }}" class="mz-btn mz-btn--ghost">{{ section.settings.cta2 }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

<script>
  (function () {
    var h = document.querySelector('[data-mzh]');
    if (!h) return;
    h.addEventListener('mousemove', function (e) {
      var r = h.getBoundingClientRect();
      h.style.setProperty('--mx', ((e.clientX - r.left) / r.width) * 100 + '%');
      h.style.setProperty('--my', ((e.clientY - r.top) / r.height) * 100 + '%');
    });
  })();
</script>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "image_src", "label": "Background image URL (used when no image is picked)", "default": "https://mazrood.com/cdn/shop/files/hf_20260910_025717_834f1492-07a4-423a-8a08-0767d3051c43_2000x.png?v=1789013116" },
    { "type": "text", "id": "tag", "label": "Top tag", "default": "Mazrood Studio — FW26" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "FW26 — Fall / Winter 2026" },
    { "type": "text", "id": "title", "label": "Title", "default": "Winter is" },
    { "type": "text", "id": "title_bold", "label": "Title (bold italic)", "default": "coming" },
    { "type": "textarea", "id": "desc", "label": "Description", "default": "Final pieces from last season's studio collection. Once they're gone, they're gone." },
    { "type": "text", "id": "cta1", "label": "Primary button", "default": "Shop the Archive" },
    { "type": "text", "id": "cta1_url", "label": "Primary button link", "default": "/collections/fw25-26" },
    { "type": "text", "id": "cta2", "label": "Secondary button", "default": "Join the List" },
    { "type": "text", "id": "cta2_url", "label": "Secondary button link", "default": "#early-access" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}