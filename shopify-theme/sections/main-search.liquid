<section class="container searchp">
  <h1 class="sec-title">Search</h1>
  <form action="{{ routes.search_url }}" method="get" role="search" class="searchp-form">
    <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search products…" aria-label="Search">
    <button type="submit" class="btn btn-solid">Search</button>
  </form>

  {%- if search.performed -%}
    <p class="coll-count">{{ search.results_count }} results</p>
    {%- paginate search.results by 24 -%}
      <div class="prod-grid" style="grid-template-columns:repeat(4,1fr)">
        {%- for item in search.results -%}
          {%- if item.object_type == 'product' -%}
            {% render 'mz-product-card', product: item %}
          {%- else -%}
            <a href="{{ item.url }}" class="searchp-page">
              <h3>{{ item.title }}</h3>
              <p>{{ item.content | strip_html | truncate: 120 }}</p>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}
        <nav class="pager" aria-label="Pagination">
          {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">&larr;</a>{%- endif -%}
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}
              <a href="{{ part.url }}">{{ part.title }}</a>
            {%- else -%}
              <span class="is-current">{{ part.title }}</span>
            {%- endif -%}
          {%- endfor -%}
          {%- if paginate.next -%}<a href="{{ paginate.next.url }}">&rarr;</a>{%- endif -%}
        </nav>
      {%- endif -%}
    {%- endpaginate -%}
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Search",
  "settings": []
}
{% endschema %}