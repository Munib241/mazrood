{{ 'mz-ss26.css' | asset_url | stylesheet_tag }}

{%- if section.settings.show_hero -%}
<div class="mzh-hero" id="mzh-hero-wrap">
  <div class="mzh-hero-bg">
    {%- if section.settings.hero_img != blank -%}
      <img id="mzh-hero-img"
           src="{{ section.settings.hero_img | img_url: '2000x' }}"
           alt="{{ section.settings.hero_title | escape }}"
           loading="eager"
           style="object-position:{{ section.settings.focal_x }}% {{ section.settings.focal_y }}%">
    {%- else -%}
      <img id="mzh-hero-img"
           src="https://cdn.shopify.com/s/files/1/0628/3706/3928/files/hf_20260330_023019_256a6bf6-a38b-4c8b-b881-d46a4b072d62_2_2.png?v=1777223323"
           alt="{{ section.settings.hero_title | escape }}"
           loading="eager">
    {%- endif -%}
  </div>

  {%- if section.settings.card_1 != blank or section.settings.card_2 != blank -%}
  <div class="mzh-cards" id="mzh-cards">
    {%- if section.settings.card_1 != blank -%}
      <div class="mzh-card mzh-card-1"><img src="{{ section.settings.card_1 | img_url: '400x' }}" alt="" loading="lazy"></div>
    {%- endif -%}
    {%- if section.settings.card_2 != blank -%}
      <div class="mzh-card mzh-card-2"><img src="{{ section.settings.card_2 | img_url: '400x' }}" alt="" loading="lazy"></div>
    {%- endif -%}
  </div>
  {%- endif -%}

  <div class="mzh-body">
    {%- if section.settings.hero_eye != blank -%}
      <p class="mzh-eye">{{ section.settings.hero_eye }}</p>
    {%- endif -%}
    <h1 class="mzh-title">
      {{ section.settings.hero_title }}
      {%- if section.settings.hero_bold != blank -%}<em>{{ section.settings.hero_bold }}</em>{%- endif -%}
    </h1>
    <div class="mzh-rule"></div>
    <div class="mzh-bottom">
      {%- if section.settings.hero_desc != blank -%}
        <p class="mzh-desc">{{ section.settings.hero_desc }}</p>
      {%- endif -%}
      <div class="mzh-ctas">
        {%- if section.settings.cta1 != blank -%}
          <a href="{{ section.settings.cta1_url }}" class="mzh-btn mzh-btn-cream">{{ section.settings.cta1 }}</a>
        {%- endif -%}
        {%- if section.settings.cta2 != blank -%}
          <a href="{{ section.settings.cta2_url }}" class="mzh-btn mzh-btn-ghost">{{ section.settings.cta2 }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>

  <div class="mzh-scroll" aria-hidden="true">
    <span class="mzh-scroll-txt">Scroll</span>
    <div class="mzh-scroll-line"></div>
  </div>
</div>
{%- endif -%}

{%- if section.settings.show_marquee -%}
<div class="mzh-marquee" aria-hidden="true">
  <div class="mzh-mq-track">
    {%- assign mq_words = section.settings.marquee_text | split: ',' -%}
    {%- for w in mq_words -%}<span class="mzh-mq-item{% cycle '', ' mzh-gold', '', '', ' mzh-gold', '' %}">{{ w | strip }}</span>{%- endfor -%}
    {%- for w in mq_words -%}<span class="mzh-mq-item{% cycle '', ' mzh-gold', '', '', ' mzh-gold', '' %}">{{ w | strip }}</span>{%- endfor -%}
  </div>
</div>
{%- endif -%}

{%- if section.settings.show_stats -%}
<div class="mzh-stats">
  <div class="mzh-stat"><p class="mzh-stat-val">{{ section.settings.s1v }}</p><p class="mzh-stat-lbl">{{ section.settings.s1l }}</p></div>
  <div class="mzh-stat"><p class="mzh-stat-val">{{ section.settings.s2v }}</p><p class="mzh-stat-lbl">{{ section.settings.s2l }}</p></div>
  <div class="mzh-stat"><p class="mzh-stat-val">{{ section.settings.s3v }}</p><p class="mzh-stat-lbl">{{ section.settings.s3l }}</p></div>
  <div class="mzh-stat"><p class="mzh-stat-val">{{ section.settings.s4v }}</p><p class="mzh-stat-lbl">{{ section.settings.s4l }}</p></div>
</div>
{%- endif -%}

{%- if section.settings.show_grid -%}
  {%- assign mzh_col = collections[section.settings.collection] -%}
  {%- if mzh_col == blank -%}{%- assign mzh_col = collections.all -%}{%- endif -%}
  <div class="mzh-grid-section">
    <div class="mzh-sec-head">
      <div>
        <p class="mzh-sec-eye">{{ section.settings.grid_eye }}</p>
        <h2 class="mzh-sec-title">{{ section.settings.grid_title }}</h2>
      </div>
      <a href="{{ mzh_col.url }}" class="mzh-sec-link">{{ section.settings.grid_all }} &rarr;</a>
    </div>
    {{ 'mz-product-card.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'mz-product-card.js' | asset_url }}" defer></script>
    <div class="mzh-prod-grid" style="grid-template-columns:repeat({{ section.settings.grid_cols }},1fr)">
      {%- for product in mzh_col.products limit: section.settings.grid_count -%}
        {%- render 'mz-product-card', product: product -%}
      {%- else -%}
        <p style="grid-column:1/-1;text-align:center;padding:60px;font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:rgba(0,0,0,.25)">Coming soon</p>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{%- assign mzh_lb = section.blocks | where: 'type', 'lookbook' -%}
{%- if section.settings.show_look and mzh_lb.size > 0 -%}
<div class="mzh-lb-wrap">
  <div class="mzh-lb-head">
    <h2 class="mzh-lb-title">{{ section.settings.look_title }}</h2>
    {%- if section.settings.look_url != blank -%}
      <a href="{{ section.settings.look_url }}" class="mzh-lb-link">{{ section.settings.look_lbl }} &rarr;</a>
    {%- endif -%}
  </div>
  <div class="mzh-lb-grid">
    {%- for block in mzh_lb -%}
      <div class="mzh-lb-item" {{ block.shopify_attributes }}>
        {%- if block.settings.img != blank -%}
          <img src="{{ block.settings.img | img_url: '900x' }}" alt="{{ block.settings.name | escape }}" loading="lazy">
        {%- endif -%}
        <div class="mzh-lb-over">
          {%- if block.settings.name != blank -%}<p class="mzh-lb-name">{{ block.settings.name }}</p>{%- endif -%}
          {%- if block.settings.sub  != blank -%}<p class="mzh-lb-sub">{{ block.settings.sub }}</p>{%- endif -%}
          {%- if block.settings.url  != blank -%}
            <a href="{{ block.settings.url }}" class="mzh-lb-cta">{{ block.settings.btn | default: 'Shop the Look' }}</a>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>
{%- endif -%}

{%- if section.settings.show_banner -%}
<div class="mzh-banner">
  {%- if section.settings.banner_img != blank -%}
  <div class="mzh-banner-img">
    <img src="{{ section.settings.banner_img | img_url: '1200x' }}" alt="{{ section.settings.banner_title | escape }}" loading="lazy">
  </div>
  {%- endif -%}
  <div class="mzh-banner-body">
    {%- if section.settings.banner_eye != blank -%}<p class="mzh-banner-eye">{{ section.settings.banner_eye }}</p>{%- endif -%}
    <h2 class="mzh-banner-title">{{ section.settings.banner_title }}</h2>
    <div class="mzh-banner-rule"></div>
    {%- if section.settings.banner_text != blank -%}<p class="mzh-banner-text">{{ section.settings.banner_text }}</p>{%- endif -%}
    {%- if section.settings.banner_cta != blank -%}
      <a href="{{ section.settings.banner_url }}" class="mzh-btn mzh-btn-ghost">{{ section.settings.banner_cta }}</a>
    {%- endif -%}
  </div>
</div>
{%- endif -%}

{%- if section.settings.show_nl -%}
<div class="mzh-nl">
  {%- if section.settings.nl_eye != blank -%}<p class="mzh-nl-eye">{{ section.settings.nl_eye }}</p>{%- endif -%}
  <h2 class="mzh-nl-title">{{ section.settings.nl_title }}</h2>
  {%- if section.settings.nl_sub != blank -%}<p class="mzh-nl-sub">{{ section.settings.nl_sub }}</p>{%- endif -%}
  {%- form 'customer' -%}
    <input type="hidden" name="contact[tags]" value="newsletter">
    <div class="mzh-nl-form">
      <input class="mzh-nl-input" type="email" name="contact[email]"
             placeholder="{{ section.settings.nl_ph }}" required autocomplete="email">
      <button type="submit" class="mzh-nl-btn">{{ section.settings.nl_btn }}</button>
    </div>
  {%- endform -%}
</div>
{%- endif -%}

<script>
(function(){
  /* Hero parallax */
  var bg = document.getElementById('mzh-hero-img');
  if(bg){
    window.addEventListener('scroll',function(){
      if(window.scrollY < window.innerHeight*1.2){
        bg.style.transform='translateY('+(window.scrollY*0.28)+'px)';
      }
    },{passive:true});
  }
  /* 3D cards */
  var wrap = document.getElementById('mzh-hero-wrap');
  var cards = document.querySelectorAll('.mzh-card');
  if(wrap && cards.length){
    wrap.addEventListener('mousemove',function(e){
      var r=wrap.getBoundingClientRect();
      var x=(e.clientX-r.left)/r.width-.5;
      var y=(e.clientY-r.top)/r.height-.5;
      cards.forEach(function(c,i){
        var f=i===0?12:8;
        c.style.transform='perspective(900px) rotateY('+(-14+x*f)+'deg) rotateX('+(5-y*f)+'deg)';
      });
    });
    wrap.addEventListener('mouseleave',function(){
      cards.forEach(function(c,i){
        c.style.transform=i===0
          ?'perspective(900px) rotateY(-14deg) rotateX(5deg)'
          :'perspective(900px) rotateY(-10deg) rotateX(3deg)';
      });
    });
  }
  /* Reveal on scroll */
  var revEls = document.querySelectorAll('.mzh-prod-card,.mzh-stat,.mzh-lb-item');
  if('IntersectionObserver' in window){
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if(e.isIntersecting){ e.target.classList.add('mzh-vis'); io.unobserve(e.target); }
      });
    },{threshold:0.06,rootMargin:'0px 0px -20px 0px'});
    revEls.forEach(function(el){ io.observe(el); });
  } else {
    revEls.forEach(function(el){ el.classList.add('mzh-vis'); });
  }
})();
</script>

{% schema %}
{
  "name": "SS26 Launch Section",
  "settings": [
    { "type": "header",       "content": "🖼 Hero" },
    { "type": "checkbox",     "id": "show_hero",   "label": "Show hero",             "default": true },
    { "type": "image_picker", "id": "hero_img",    "label": "Background image" },
    { "type": "range", "id": "focal_x", "min": 0, "max": 100, "step": 5, "label": "Focal point X%", "default": 50 },
    { "type": "range", "id": "focal_y", "min": 0, "max": 100, "step": 5, "label": "Focal point Y%", "default": 20 },
    { "type": "text",         "id": "hero_eye",    "label": "Eyebrow",               "default": "Mazrood Studio — Summer 2026" },
    { "type": "text",         "id": "hero_title",  "label": "Title (light)",         "default": "Summer" },
    { "type": "text",         "id": "hero_bold",   "label": "Title (bold line)",     "default": "26" },
    { "type": "text",         "id": "hero_desc",   "label": "Description",           "default": "The new collection. Now live." },
    { "type": "text",         "id": "cta1",        "label": "Primary CTA label",     "default": "Shop New Arrivals" },
    { "type": "url",          "id": "cta1_url",    "label": "Primary CTA link" },
    { "type": "text",         "id": "cta2",        "label": "Secondary CTA label",   "default": "View All" },
    { "type": "url",          "id": "cta2_url",    "label": "Secondary CTA link" },
    { "type": "header",       "content": "🃏 Floating Cards" },
    { "type": "image_picker", "id": "card_1",      "label": "Card image 1" },
    { "type": "image_picker", "id": "card_2",      "label": "Card image 2" },
    { "type": "header",       "content": "📢 Marquee" },
    { "type": "checkbox",     "id": "show_marquee","label": "Show marquee",           "default": true },
    { "type": "textarea",     "id": "marquee_text","label": "Items (comma-separated)","default": "New Arrivals, SS26, Mazrood Studio, Summer 2026, Now Live, Free Returns" },
    { "type": "header",       "content": "📊 Stats" },
    { "type": "checkbox",     "id": "show_stats",  "label": "Show stats",             "default": true },
    { "type": "text", "id": "s1v", "label": "Stat 1 value", "default": "SS26" },
    { "type": "text", "id": "s1l", "label": "Stat 1 label", "default": "New Season" },
    { "type": "text", "id": "s2v", "label": "Stat 2 value", "default": "KSA & Global" },
    { "type": "text", "id": "s2l", "label": "Stat 2 label", "default": "We Ship" },
    { "type": "text", "id": "s3v", "label": "Stat 3 value", "default": "2–5" },
    { "type": "text", "id": "s3l", "label": "Stat 3 label", "default": "Day Delivery" },
    { "type": "text", "id": "s4v", "label": "Stat 4 value", "default": "Free" },
    { "type": "text", "id": "s4l", "label": "Stat 4 label", "default": "Returns" },
    { "type": "header",       "content": "🛍 Product Grid" },
    { "type": "checkbox",     "id": "show_grid",   "label": "Show product grid",      "default": true },
    { "type": "collection",   "id": "collection",  "label": "Collection" },
    { "type": "range", "id": "grid_count", "min": 4, "max": 16, "step": 4, "label": "Products to show", "default": 8 },
    { "type": "range", "id": "grid_cols",  "min": 2, "max": 5,  "step": 1, "label": "Desktop columns",  "default": 4 },
    { "type": "text",         "id": "grid_eye",    "label": "Section eyebrow",        "default": "SS26" },
    { "type": "text",         "id": "grid_title",  "label": "Section title",          "default": "New Arrivals" },
    { "type": "text",         "id": "grid_all",    "label": "View all label",         "default": "View All" },
    { "type": "header",       "content": "📷 Lookbook" },
    { "type": "checkbox",     "id": "show_look",   "label": "Show lookbook",          "default": true },
    { "type": "text",         "id": "look_title",  "label": "Title",                  "default": "The Look" },
    { "type": "url",          "id": "look_url",    "label": "Link" },
    { "type": "text",         "id": "look_lbl",    "label": "Link label",             "default": "Shop All" },
    { "type": "header",       "content": "🌅 Feature Banner" },
    { "type": "checkbox",     "id": "show_banner", "label": "Show banner",            "default": true },
    { "type": "image_picker", "id": "banner_img",  "label": "Banner image" },
    { "type": "text",         "id": "banner_eye",  "label": "Eyebrow",               "default": "Mazrood Studio — 2026" },
    { "type": "text",         "id": "banner_title","label": "Title",                  "default": "Made for Summer." },
    { "type": "textarea",     "id": "banner_text", "label": "Body text",             "default": "Lightweight fabrics, considered silhouettes, and a spirit built for the season." },
    { "type": "text",         "id": "banner_cta",  "label": "CTA label",             "default": "Shop SS26" },
    { "type": "url",          "id": "banner_url",  "label": "CTA link" },
    { "type": "header",       "content": "✉️ Newsletter" },
    { "type": "checkbox",     "id": "show_nl",     "label": "Show newsletter",        "default": true },
    { "type": "text",         "id": "nl_eye",      "label": "Eyebrow",               "default": "Stay in the loop" },
    { "type": "text",         "id": "nl_title",    "label": "Title",                  "default": "Never miss a drop" },
    { "type": "text",         "id": "nl_sub",      "label": "Subtitle",              "default": "New arrivals, exclusive access, and early sales — straight to your inbox." },
    { "type": "text",         "id": "nl_ph",       "label": "Input placeholder",     "default": "Your email address" },
    { "type": "text",         "id": "nl_btn",      "label": "Button label",          "default": "Subscribe" }
  ],
  "blocks": [
    {
      "type": "lookbook",
      "name": "Lookbook Image",
      "settings": [
        { "type": "image_picker", "id": "img",  "label": "Image" },
        { "type": "text",         "id": "name", "label": "Name",    "default": "Mazrood Studio" },
        { "type": "text",         "id": "sub",  "label": "Subtitle","default": "SS26" },
        { "type": "url",          "id": "url",  "label": "Link" },
        { "type": "text",         "id": "btn",  "label": "Button",  "default": "Shop the Look" }
      ]
    }
  ],
  "presets": [
    {
      "name": "SS26 Launch Section",
      "blocks": [
        { "type": "lookbook", "settings": { "name": "Striped Shirt II & Shorts", "sub": "SS26 — Men",   "btn": "Shop the Look" } },
        { "type": "lookbook", "settings": { "name": "Striped Shirt & Shorts",    "sub": "SS26 — Men",   "btn": "Shop the Look" } },
        { "type": "lookbook", "settings": { "name": "Women's Lounge Set",         "sub": "SS26 — Women", "btn": "Shop the Look" } }
      ]
    }
  ]
}
{% endschema %}
