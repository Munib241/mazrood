<div class="page-width" style="padding-bottom: 90px;">
  <div class="page-head">
    <span class="eyebrow">Journal</span>
    <h1>{{ blog.title }}</h1>
  </div>

  {%- paginate blog.articles by 12 -%}
    {%- for article in blog.articles -%}
      <article class="article-card">
        {%- if article.image -%}
          <a href="{{ article.url }}">
            {{ article.image | image_url: width: 1600 | image_tag: loading: 'lazy', alt: article.title | escape }}
          </a>
        {%- endif -%}
        <h2><a href="{{ article.url }}">{{ article.title }}</a></h2>
        <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%b %d, %Y' }}</time>
        <p style="color: var(--muted); max-width: 60ch;">{{ article.excerpt_or_content | strip_html | truncate: 180 }}</p>
      </article>
    {%- else -%}
      <p>No posts yet.</p>
    {%- endfor -%}

    {%- if paginate.pages > 1 -%}
      <div class="pagination">
        {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">&larr; Previous</a>{%- endif -%}
        {%- if paginate.next -%}<a href="{{ paginate.next.url }}">Next &rarr;</a>{%- endif -%}
      </div>
    {%- endif -%}
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "Blog",
  "settings": []
}
{% endschema %}