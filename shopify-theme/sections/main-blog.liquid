{%- paginate blog.articles by 12 -%}
<section class="container blogp">
  <h1 class="sec-title">{{ blog.title }}</h1>
  <div class="blog-grid" style="margin-top:28px">
    {%- for article in blog.articles -%}
      <a href="{{ article.url }}" class="blog-card">
        {%- if article.image -%}
          <div class="blog-card-img">
            <img src="{{ article.image | img_url: '700x' }}" alt="{{ article.title | escape }}" loading="lazy">
          </div>
        {%- endif -%}
        <h3>{{ article.title }}</h3>
        <p>{{ article.published_at | date: '%B %-d, %Y' }}{% if section.settings.show_excerpt %} &middot; {{ article.excerpt_or_content | strip_html | truncate: 110 }}{% endif %}</p>
      </a>
    {%- else -%}
      <p class="sec-empty">No articles yet</p>
    {%- endfor -%}
  </div>
  {%- if paginate.pages > 1 -%}
    <nav class="pager" aria-label="Pagination">
      {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">&larr;</a>{%- endif -%}
      {%- for part in paginate.parts -%}
        {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>{%- else -%}<span class="is-current">{{ part.title }}</span>{%- endif -%}
      {%- endfor -%}
      {%- if paginate.next -%}<a href="{{ paginate.next.url }}">&rarr;</a>{%- endif -%}
    </nav>
  {%- endif -%}
</section>
{%- endpaginate -%}

{% schema %}
{
  "name": "Blog",
  "settings": [
    { "type": "checkbox", "id": "show_excerpt", "label": "Show excerpt", "default": true }
  ]
}
{% endschema %}