<article class="article">
  {%- if article.image -%}
    <div class="article-img">
      <img src="{{ article.image | img_url: '1200x' }}" alt="{{ article.title | escape }}">
    </div>
  {%- endif -%}
  <p class="article-meta">{{ article.published_at | date: '%B %-d, %Y' }}</p>
  <h1 class="sec-title" style="font-size:clamp(24px,4vw,44px)">{{ article.title }}</h1>
  <div class="rte">{{ article.content }}</div>
</article>

{% schema %}
{
  "name": "Article",
  "settings": []
}
{% endschema %}